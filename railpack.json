{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "node": "22",
    "python": "3.12"
  },
  "steps": {
    "install": {
      "commands": [
        "..."
      ]
    },
    "build": {
      "commands": [
        "pip install --no-cache-dir -r requirements.txt",
        "..."
      ]
    }
  },
  "deploy": {
    "startCommand": "python -m pip install --no-cache-dir -r requirements.txt && python -m uvicorn backend.main:app --host 0.0.0.0 --port ${PORT}"
  }
}
